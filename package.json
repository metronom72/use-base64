{
  "name": "use-base64",
  "version": "0.1.5",
  "type": "module",
  "description": "React hook + helpers to encode strings to Base64 (RFC 4648) in any JS runtime.",
  "keywords": [
    "react",
    "hook",
    "hooks",
    "base64",
    "encode",
    "decode",
    "image",
    "canvas",
    "file",
    "conversion",
    "typescript",
    "browser",
    "node",
    "ssr",
    "universal"
  ],
  "license": "MIT",
  "author": "Mikhail Dorokhovich",
  "repository": {
    "type": "git",
    "url": "https://github.com/metronom72/use-base64.git"
  },
  "homepage": "https://github.com/metronom72/use-base64#readme",
  "bugs": {
    "url": "https://github.com/metronom72/use-base64/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.types.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=16.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
